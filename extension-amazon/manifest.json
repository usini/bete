{
  "manifest_version": 3,
  "name": "Bête — Copier un produit Amazon",
  "version": "0.1.0",
  "description": "Copie une fiche produit Amazon pour la coller dans Bête.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://m.media-amazon.com/*",
    "https://images-na.ssl-images-amazon.com/*",
    "https://images-eu.ssl-images-amazon.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Copier dans Bête"
  }
}